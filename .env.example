# ==============================================================================
# Go Backend Configuration
# ==============================================================================
PORT=8080
JWT_SECRET=super_secret_jwt_key_please_change_in_production

# Individual Database Settings (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taskmanager
DB_SSLMODE=disable

# Unified Database URL (takes precedence if set)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskmanager?sslmode=disable

# ==============================================================================
# Next.js Frontend Configuration
# ==============================================================================
# The address of the backend API as seen by the browser client
NEXT_PUBLIC_API_URL=http://localhost:8080
